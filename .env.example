# Formspree — create a new form at https://formspree.io pointed at trish.mag@hotmail.com
# and paste its endpoint URL here (looks like https://formspree.io/f/xxxxxxxx)
VITE_FORMSPREE_ENDPOINT=

# Firebase — create a project at https://console.firebase.google.com, enable Firestore,
# and paste the web app config values here. See README.md for full setup steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
